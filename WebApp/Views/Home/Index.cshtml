@model IEnumerable<Proyector>
@using System.Linq
@{
    ViewData["Title"] = "Inicio";
}

@if (Model != null)
{
    <div class="container">
        <h1>Proyectores</h1>
        <h3>Información de proyectores registrados</h3>
        @if (Model.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th># Proyector</th>
                        <th>Marca</th>
                        <th>Modelo</th>
                        <th># de serie</th>
                        <th>Situación</th>
                        <th>Fecha de alta</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var proyector in Model)
                    {
                        <tr>
                            <td>@proyector.Id</td>
                            <td>@proyector.Marca</td>
                            <td>@proyector.Modelo</td>
                            <td>@proyector.NumeroDeSerie</td>
                            <td>@proyector.Situacion</td>
                            <td>@proyector.FechaDeAlta.ToString("d")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No hay proyectores registrados.</p>
        }
    </div>
}
else
{
    <p>No hay datos.</p>
}